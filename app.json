{
  "expo": {
    "name": "PontoCerto",
    "slug": "pontocerto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pontocerto",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "br.com.fiap.pontocerto",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O PontoCerto usa sua localização para achar os pontos de ônibus perto de você, calcular a caminhada até eles e avisar quando estiver chegando ao ponto de descida."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6E4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fiap.pontocerto",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O PontoCerto usa sua localização para achar os pontos de ônibus perto de você, calcular a caminhada até eles e avisar quando estiver chegando ao ponto de descida."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6E4F"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B6E4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
